<tool id="CONVERTER_nexus_to_phylip_0" name="Convert Nexus to Phylip" version="1.0.0" hidden="true">
    <requirements>
        <requirement type="package" version="0.3.1">goalign</requirement>
    </requirements>
    <command>goalign reformat phylip --clean-names --nexus -i '$input1' > '$output1'</command>
    <inputs>
        <param format="nex" name="input1" type="data" label="Choose Nexus"/>
    </inputs>
    <outputs>
        <data format="phylip" name="output1"/>
    </outputs>
    <help>
    </help>
</tool>
